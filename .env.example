# ================================================================
# BACKEND ENVIRONMENT VARIABLES (EXAMPLE / TEMPLATE)
# ================================================================
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# NEVER commit the real `.env` file. See .gitignore.
# ================================================================

# ----------------------------------------------------------------
# Server
# ----------------------------------------------------------------
NODE_ENV=development
APP_PORT=4000

# Allowed frontend origin(s) for CORS (comma separated if multiple).
FRONTEND_HOST=http://localhost:5173

# ----------------------------------------------------------------
# AI (Google Gemini / Groq)
# ----------------------------------------------------------------
# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (optional) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ----------------------------------------------------------------
# AI Assistant Identity + Social URLs
# ----------------------------------------------------------------
# These are NOT env vars anymore — they are STATIC, code-based config so they
# stay versioned and avoid env drift. Edit them in:
#   - backend/config/identityConfig.js  → brand, owner, company, social URLs
# Nothing there is secret (public branding/identity), so code is the right home.

# ----------------------------------------------------------------
# Email Configuration (SMTP) — used for contact form submissions
# Generate a Gmail app password at:
# https://myaccount.google.com/apppasswords
# ----------------------------------------------------------------
EMAIL_HOST=smtp.googlemail.com
EMAIL_PORT=465
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password_here
# Address that receives contact-form notifications (falls back to EMAIL_USERNAME)
EMAIL_RECIPIENT=your_email@gmail.com
# Optional public/business email
EMAIL_BUSINESS=business@example.com

# ----------------------------------------------------------------
# WhatsApp / Meta (Facebook) Business API
# Used for WhatsApp contact integration.
# Get credentials at: https://developers.facebook.com/
# ----------------------------------------------------------------
APP_ID=your_meta_app_id_here
APP_SECRET=your_meta_app_secret_here
RECIPIENT_WAID=your_whatsapp_number_without_plus
VERSION=v18.0
PHONE_NUMBER_ID=your_meta_phone_number_id_here
ACCESS_TOKEN=your_meta_access_token_here

# ----------------------------------------------------------------
# GitHub API — used for contribution stats
# Token: https://github.com/settings/tokens
# ----------------------------------------------------------------
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_token_here

# ----------------------------------------------------------------
# WakaTime API — used for coding statistics
# Get API key at: https://wakatime.com/settings/api
# ----------------------------------------------------------------
WAKATIME_APP_SECRET=your_wakatime_api_key_here
# Optional tuning (defaults shown) — helps if wakatime.com is slow/flaky
# WAKATIME_TIMEOUT_MS=8000
# WAKATIME_MAX_RETRIES=2
# WAKATIME_CACHE_TTL_MS=300000

# ----------------------------------------------------------------
# Static data (NO third-party APIs / secrets needed)
# ----------------------------------------------------------------
# Crypto prices and social follower counts are STATIC and live in code so no
# API key can ever leak to a website visitor:
#   - backend/config/cryptoConfig.js  → BTC / ETH / SOL prices + 30d delta
#   - backend/config/socialConfig.js  → TikTok / Instagram followers
# Edit those files and restart the server to update the values.

# ----------------------------------------------------------------
# Google Cloud / Sheets (optional)
# Only needed if you store form data in a Google Sheet.
# Create a service account and download its JSON key.
# ----------------------------------------------------------------
GOOGLE_CLIENT_EMAIL=your_service_account_email@your-project.iam.gserviceaccount.com
# Keep the \n escapes and wrap in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Shared secret guarding sheet access
SHEET_SECRET_KEY=your_sheet_secret_key_here

# ----------------------------------------------------------------
# Security
# ----------------------------------------------------------------
# bcrypt hash used for application key validation.
# Generate with: node -e "console.log(require('bcrypt').hashSync(require('crypto').randomBytes(24).toString('hex'), 10))"
APP_KEY_HASH=your_app_key_hash_here
