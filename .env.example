# ================================================================
# BACKEND ENVIRONMENT VARIABLES (EXAMPLE / TEMPLATE)
# ================================================================
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# NEVER commit the real `.env` file. See .gitignore.
# ================================================================

# ----------------------------------------------------------------
# Server
# ----------------------------------------------------------------
NODE_ENV=development
APP_PORT=4000

# Allowed frontend origin(s) for CORS — comma separated.
# A bare domain is expanded automatically to its https:// and www. variants,
# so `fiqtor.com` also allows https://fiqtor.com and https://www.fiqtor.com.
#   local:      http://localhost:5173
#   production: https://fiqtor.com   (or bare: fiqtor.com)
FRONTEND_HOST=http://localhost:5173

# ----------------------------------------------------------------
# AI (Google Gemini)
# ----------------------------------------------------------------
# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model ids (optional). PRIMARY must be a published, non-retired id — an
# invalid one fails on every request and silently retries on FALLBACK, which
# doubles latency. Both must be valid Gemini model ids.
AI_MODEL_PRIMARY=gemini-2.5-flash-lite
AI_MODEL_FALLBACK=gemini-3-flash-preview

# ----------------------------------------------------------------
# AI Assistant Identity + Social URLs
# ----------------------------------------------------------------
# These are NOT env vars anymore — they are STATIC, code-based config so they
# stay versioned and avoid env drift. Edit them in:
#   - backend/src/config/identity.js  → brand, owner, company, social URLs
# Nothing there is secret (public branding/identity), so code is the right home.

# ----------------------------------------------------------------
# Email Configuration (SMTP) — used for contact form submissions
# Generate a Gmail app password at:
# https://myaccount.google.com/apppasswords
# ----------------------------------------------------------------
EMAIL_HOST=smtp.googlemail.com
EMAIL_PORT=465
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password_here
# Address that receives contact-form notifications (falls back to EMAIL_USERNAME)
EMAIL_RECIPIENT=your_email@gmail.com

# ----------------------------------------------------------------
# WhatsApp / Meta (Facebook) Business API
# Used for WhatsApp contact integration (outbound messages only).
# Get credentials at: https://developers.facebook.com/
# ----------------------------------------------------------------
RECIPIENT_WAID=your_whatsapp_number_without_plus
VERSION=v18.0
PHONE_NUMBER_ID=your_meta_phone_number_id_here
ACCESS_TOKEN=your_meta_access_token_here

# ----------------------------------------------------------------
# GitHub API — used for contribution stats
# Token: https://github.com/settings/tokens
# ----------------------------------------------------------------
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_token_here

# ----------------------------------------------------------------
# WakaTime API — used for coding statistics
# Get API key at: https://wakatime.com/settings/api
# ----------------------------------------------------------------
WAKATIME_APP_SECRET=your_wakatime_api_key_here
# Optional tuning (defaults shown) — helps if wakatime.com is slow/flaky
# WAKATIME_TIMEOUT_MS=8000
# WAKATIME_MAX_RETRIES=2
# WAKATIME_CACHE_TTL_MS=300000

# ----------------------------------------------------------------
# Live market data (NO secrets required)
# ----------------------------------------------------------------
# Crypto prices are fetched LIVE server-side from CoinGecko's public API, so no
# key is ever exposed to the browser. Cached in memory for 30s to respect the
# upstream rate limit; on upstream failure it serves stale cache, then the
# static fallback in backend/src/config/crypto.js.
# Optional tuning (defaults shown):
# CRYPTO_TIMEOUT_MS=8000
# CRYPTO_CACHE_TTL_MS=30000
# Optional CoinGecko demo key for higher rate limits (public tier works without):
# COINGECKO_API_KEY=
#
# Social follower counts are fetched REALTIME by scraping the public profile
# pages (Instagram works; TikTok usually blocks servers and falls back to the
# DEFAULT numbers below). Handles + fallback numbers live in:
#   - backend/src/config/social.js  → TikTok / Instagram usernames + defaults
# Optional tuning (defaults shown) — raise the TTL to reduce upstream traffic:
# SOCIAL_TIMEOUT_MS=8000
# SOCIAL_CACHE_TTL_MS=900000

# ----------------------------------------------------------------
# Logging (pino)
# ----------------------------------------------------------------
# Log level: trace | debug | info | warn | error | fatal
# Defaults: "debug" in development, "info" in production.
# LOG_LEVEL=info

# ----------------------------------------------------------------
# Sentry — error tracking (OPTIONAL)
# Leave empty to disable. Create a project at: https://sentry.io/
# ----------------------------------------------------------------
SENTRY_DSN=
# SENTRY_RELEASE=api@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0
